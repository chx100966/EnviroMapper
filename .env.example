# Copy to .env (git-ignored) and set your own passwords: cp .env.example .env
# Used by docker-compose.yml - see db/README.md.

# Superuser of the local Postgres server (admin tasks only, not for applications).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser

# Owner of the enviromapper_app database (users, devices, configuration).
APP_DB_PASSWORD=change-me-app

# Owner of the enviromapper_telemetry database (sensor readings, TimescaleDB).
TELEMETRY_DB_PASSWORD=change-me-telemetry

# Host ports (bound to 127.0.0.1). Change POSTGRES_PORT if a local Postgres already uses 5432.
POSTGRES_PORT=5432
MQTT_PORT=1883
ADMINER_PORT=8080
