<Window x:Class="Symulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Symulator maszyny produkcyjnej"
        Height="750"
        Width="1100"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F1F4F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SYMULATOR MASZYNY PRODUKCYJNEJ"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="System monitorowania parametrów pracy urządzenia"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="STATUS MASZYNY"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="MachineStatus"
                               Text="ZATRZYMANA"
                               FontSize="22"
                               FontWeight="Bold" 
                               Margin="0,5,0,0"
                               />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="ConnectionStatus"
                           Text="Brak połączenia z Serwerem"
                           FontSize="13"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,10,10">

                <StackPanel>
                    <TextBlock Text="TEMPERATURA"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="TemperatureValue"
                               Text="22.0 °C"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,15,0,5"/>

                    <TextBlock Text="Czujnik temperatury"
                               Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="5,0,5,10">

                <StackPanel>
                    <TextBlock Text="CIŚNIENIE"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="PressureValue"
                               Text="2.0 bar"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,15,0,5"/>

                    <TextBlock Text="Czujnik ciśnienia"
                               Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="10,0,0,10">

                <StackPanel>
                    <TextBlock Text="WIBRACJE"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="VibrationValue"
                               Text="0 mm/s"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,15,0,5"/>

                    <TextBlock Text="Czujnik drgań"
                               Foreground="#94A3B8"/>
                </StackPanel>
            </Border>


            <Border Grid.Row="1" Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,10,10,0">

                <StackPanel>
                    <TextBlock Text="PRĘDKOŚĆ OBROTOWA"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="RpmValue"
                               Text="0 RPM"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,15,0,5"/>

                    <TextBlock Text="Obroty silnika"
                               Foreground="#94A3B8"/>
                </StackPanel>
            </Border>


            <Border Grid.Row="1" Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="5,10,5,0">

                <StackPanel>
                    <TextBlock Text="POBÓR PRĄDU"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="CurrentValue"
                               Text="0 A"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,15,0,5"/>

                    <TextBlock Text="Natężenie prądu"
                               Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="10,10,0,0">

                <StackPanel>
                    <TextBlock Text="OBCIĄŻENIE"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="LoadValue"
                               Text="0 %"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,15,0,5"/>

                    <TextBlock Text="Obciążenie maszyny"
                               Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

        </Grid>


        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,20,664,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="URUCHOM MASZYNĘ"
                        Width="156"
                        Height="45"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0" 
                        Click="StartButton_Click"/>

                <Button Content="ZATRZYMAJ MASZYNĘ"
                        Width="168"
                        Height="45"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="5"
                        Click="StopButton_Click"/>

            </StackPanel>
        </Border>

        <Border 
            Background="White" 
            CornerRadius="10" 
            Height="85" 
            Margin="591,20,64,0" 
            Grid.Row="3" 
            VerticalAlignment="Top"/>
        <Button 
                Content="ZASTOSUJ SCENARIUSZ" 
                HorizontalAlignment="Left" 
                Height="42" 
                Margin="618,37,0,0" 
                Grid.Row="3" 
                VerticalAlignment="Top" 
                Background="Orange"
                Foreground="White"
                FontWeight="Bold"
                Width="152"
                Click="ScenarioButton_Click"/>
        <ComboBox 
                x:Name="Chose"
                HorizontalAlignment="Left" 
                Height="21" 
                Margin="794,47,0,0" 
                Grid.Row="3" 
                VerticalAlignment="Top" 
                Width="134">
            <ComboBoxItem Content="Normalna praca"/>
            <ComboBoxItem Content="Przegrzewanie"/>
            <ComboBoxItem Content="Spadek ciśnienia"/>
            <ComboBoxItem Content="Uszkodzenie łożyska"/>
            <ComboBoxItem Content="Przeciążenie"/>
        </ComboBox>
    </Grid>
</Window>