# Copy to ai/.env (git-ignored) - see ai/README.md.
# The defaults match the mosquitto container from docker-compose.yml (docker compose up -d mqtt).
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false               # true: TLS, default port 8883
# MQTT_TOPIC_PREFIX=enviromapper/telemetry
