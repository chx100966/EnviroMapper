# Copy to ai/.env (git-ignored) - see ai/README.md for a script that fills it in.
# From infra/terraform:
#   tofu output -raw dps_id_scope
#   az keyvault secret show --vault-name "$(tofu output -raw key_vault_name)" \
#     --name dps-enrollment-key-agriculture --query value -o tsv
DPS_ID_SCOPE=
DPS_ENROLLMENT_KEY_AGRICULTURE=
DPS_ENROLLMENT_KEY_INDUSTRY=
DPS_ENROLLMENT_KEY_WEATHER=
# DPS_PROVISIONING_HOST=global.azure-devices-provisioning.net

# Instead of DPS: one device created by hand (az iot hub device-identity create), used with --mode.
# IOTHUB_DEVICE_CONNECTION_STRING=HostName=...;DeviceId=...;SharedAccessKey=...
